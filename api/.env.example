# Copy to .env for local dev (never commit the real .env).

PORT=3001

# Unset -> falls back to an in-memory store (fine for local dev, data lost
# on restart). Production (Phase 7) sets this to the Supabase connection
# string.
DATABASE_URL=

# anthropic | openrouter | mock (mock = canned replies, no network call,
# no cost — the default; safe for local dev/CI)
LLM_PROVIDER=mock

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
ANTHROPIC_RPM=5
ANTHROPIC_RPD=100
# Extra safety net protecting the Claude build credit specifically.
ANTHROPIC_HARD_DAILY_CAP=50

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_RPM=20
OPENROUTER_RPD=200

TWIN_CHAT_MAX_MESSAGE_LENGTH=500
TWIN_CHAT_RATE_LIMIT_WINDOW_MS=60000
TWIN_CHAT_RATE_LIMIT_MAX=10

CLIENT_MAX_RETRY_ATTEMPTS=3
